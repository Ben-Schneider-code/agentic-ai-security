# Start from base
# Build base first: docker build -f dockerfile.base -t agentic-security-base .
FROM agentic-security-base

# Interactive mode files
COPY run_interactive.sh /app/run_interactive.sh
RUN chmod +x /app/run_interactive.sh
COPY interactive_sql_env.py /app/interactive_sql_env.py

# Start services and keep container interactive
CMD /app/run_interactive.sh
