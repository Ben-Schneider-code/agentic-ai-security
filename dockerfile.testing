# Start from base
# Build base first: docker build -f dockerfile.base -t agentic-security-base .
FROM agentic-security-base

# Testing mode startup script
COPY start_testing_no_vllm.sh /app/start_testing_no_vllm.sh
RUN chmod +x /app/start_testing_no_vllm.sh

# The base image copies util/, so run_conversations.py will be there if it exists in local util/

CMD /app/start_testing_no_vllm.sh
